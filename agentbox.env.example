# Settings for build-iso.sh. Copy to agentbox.env and edit. No secrets here:
# the password comes from the AGENTBOX_PASSWORD environment variable, or is generated.
AGENTBOX_USER=agent                      # login name of the one user (gets passwordless sudo)
AGENTBOX_HOSTNAME=agentbox
AGENTBOX_TIMEZONE=Etc/UTC                # for example Europe/Berlin
# AGENTBOX_SSH_KEY=$HOME/.ssh/id_ed25519.pub   # public key to authorize; makes SSH key-only
